+        status: 200;
+        data: ClusterGroupAdminMembersResponseDto;
+    }>(`/admin/users/${encodeURIComponent(id)}/cluster-group/members/${encodeURIComponent(memberId)}`, {
+        ...opts,
+        method: "DELETE"
+    }));
+}
